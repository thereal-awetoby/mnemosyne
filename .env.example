# Copy to .env (gitignored) and fill in. NEVER commit .env.

# Governor: FullAccess key, exported with
#   near account export-account mnemosyne-gov.testnet using-private-key network-config testnet
GOVERNOR_ACCOUNT_ID=mnemosyne-gov.testnet
GOVERNOR_PRIVATE_KEY=ed25519:...

# Sub-agents: report-only function-call keys ONLY (never FullAccess).
# Generate each with: npm run sub:keygen -- A   (see docs/PHASE3_KEYS.md)
SUB_A_ACCOUNT_ID=mnemosyne-sub-a.testnet
SUB_A_PRIVATE_KEY=
SUB_B_ACCOUNT_ID=mnemosyne-sub-b.testnet
SUB_B_PRIVATE_KEY=
SUB_C_ACCOUNT_ID=mnemosyne-sub-c2.testnet
SUB_C_PRIVATE_KEY=

# Optional
# NEAR_RPC_URL=https://rpc.testnet.near.org

# x402 memory API (npm run server) -- all optional, see docs/X402.md
# HOST=0.0.0.0
# PORT=8402
# PUBLIC_URL=http://localhost:8402   (optional; pin the public origin in production)
# X402_PRICE_YOCTO=1000000000000000000000
# ADMIN_TOKEN=pick-a-long-random-string   (operator only: Run cycle, owner limits, /memory/confess; a wallet login never grants it)
#   On a hosted site a visitor never sees Run cycle or Edit limits; the operator unlocks them
#   from the "Operator" link at the foot of the sidebar, or /dashboard?operator=1.
# LOGIN=0                        (turn off NEAR wallet sign-in and sign-up; default on, see docs/LOGIN.md)
# X402_FACILITATOR_URL=          (unset = mock facilitator)
# X402_VERIFY_NAMED_PAYERS=1     (accept named payer accounts, checked via NEAR RPC)
# EXTERNAL_AGENT_SECRET_KEY=     (npm run x402:demo payer; unset = fresh key each run)
# MNEMOSYNE_URL=http://localhost:8402  (demo target; use the public URL for a remote API)
# MNEMOSYNE_PAY_TO=mnemosyne-gov.testnet (demo recipient allowlist)

# Real x402 settlement on NEAR testnet (docs/X402.md "Two payment rails")
# X402_RAIL=near-testnet            (default: mock)
# X402_ASSET=wrap.testnet           (wNEAR)
# X402_PRICE=1000000000000000000000 (0.001 wNEAR, 24 decimals)
# X402_RELAYER_ACCOUNT_ID=          (pays gas; default GOVERNOR_ACCOUNT_ID)
# X402_RELAYER_PRIVATE_KEY=         (full-access key; default GOVERNOR_PRIVATE_KEY)
# X402_PAYER_ACCOUNT_ID=            (demo payer, from: npm run x402:setup -- --new-payer)
# X402_PAYER_PRIVATE_KEY=

# Phase 6: private decisions in a NEAR AI Cloud TEE (docs/PRIVATE.md)
# Unset = deterministic local rule, labelled decision_path "local-policy".
# NEAR_AI_API_KEY=sk-...
# NEAR_AI_MODEL=Qwen/Qwen3.8-27B
# TEE_VERIFY=full                  (or "signature": skip Intel TDX + NVIDIA checks, labelled not_checked)
# SWARM_SCENARIO=calm              (calm | stressed | recovery; swarm state is SIMULATED)

# Real swarm balances, real top-ups, limits (docs/BALANCES_AND_LIMITS.md). All testnet, tiny, off by default.
# SWARM_STATE=simulated            (or "onchain": each sub's capital = its real wNEAR balance; run npm run swarm:setup first)
# CAPITAL_UNIT_YOCTO=10000000000000000000   (1 capital unit = 0.00001 wNEAR)
# ALLOCATE_MODE=print              (or "wnear": governor tops up INCREASE subs, after the memory commit only)
# ALLOCATE_MAX_UNITS=1000          (hard cap on what one cycle may move, in units = 0.01 wNEAR)
# ADMIN_TOKEN=                     (also unlocks changing the risk limits from the dashboard)

# Phase 7: cross-chain allocation, QUOTE ONLY (docs/CROSS_CHAIN.md). Rhea / NEAR Intents are mainnet; nothing is ever sent.
# CROSS_CHAIN_ALLOCATE=1           (off by default; 1 = quote after the memory commit)
# CROSS_CHAIN_RECIPIENT=0x1234567890abcdef1234567890abcdef12345678   (a Base address YOU own: 0x + 40 hex characters; required; nothing is sent to it)
# CROSS_CHAIN_PROVIDER=            (rhea | oneclick; default rhea if RHEA_API_KEY is set, else oneclick; 'rhea' is tried without a key too)
# RHEA_API_KEY=                    (optional; from https://boss.rhea.finance; only if Rhea answers 401/403)
# ONECLICK_JWT=                    (optional 1Click JWT, sent as Authorization: Bearer; 1Click works without one)
# CROSS_CHAIN_SUB=A
# CROSS_CHAIN_UNITS=100            (units to quote, 1-1000; 100 units = 0.001 wNEAR at the default unit)
# CROSS_CHAIN_MAX_UNITS=100        (cap on the above; the code ceiling is 1000)
# CROSS_CHAIN_SLIPPAGE_BPS=50
# CROSS_CHAIN_SENDER=              (default: your governor key's own mainnet-style account, 64 hex characters; 1Click refuses a .testnet name; only a label while nothing executes)
