node_modules/
dist/
*.log
.env
.env.local
memory-log.json

# Rust / contract build artifacts
contract/target/
target/

# Everything the runtime writes is local: private reasoning blobs, user
# accounts, sessions, receipts, spent nonces.
data/runtime/*

# ...except the evidence. The public records and the proof packs carry no
# private reasoning (only a hash of it) and no personal data, and judges
# review the repository, so they belong in it. `npm run prove` checks that
# nothing private ever reached them.
!data/runtime/public/
!data/runtime/proofs/
