{
  "name": "mnemosyne",
  "version": "0.1.0",
  "private": true,
  "description": "Non-trading governor agent on NEAR: private decisions, on-chain memory commitments, capability-limited sub-agents, x402-paid memory queries.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cycle": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "verify:contract": "node scripts/verify-contract.mjs",
    "sub:keygen": "node scripts/gen-sub-key.mjs",
    "sub:check": "tsx src/tools/subKeyCheck.ts",
    "server": "tsx src/serve.ts",
    "x402:demo": "tsx src/tools/x402Demo.ts",
    "test": "tsx --test src/x402/*.test.ts src/private/*.test.ts src/dashboard/*.test.ts src/allocate/*.test.ts src/limits/*.test.ts src/auth/*.test.ts src/proof/*.test.ts",
    "x402:setup": "tsx src/tools/x402Setup.ts",
    "x402:demo:real": "tsx src/tools/x402RealDemo.ts",
    "tee:check": "tsx src/tools/teeCheck.ts",
    "swarm:setup": "tsx src/tools/swarmSetup.ts",
    "rail:check": "tsx src/tools/railCheck.ts",
    "crosschain:check": "tsx src/tools/crossChainCheck.ts",
    "crosschain:probe": "tsx src/tools/crossChainProbe.ts",
    "build:wallet": "node scripts/build-wallet.mjs",
    "prove": "tsx src/tools/prove.ts",
    "prove:live": "tsx src/tools/prove.ts --live",
    "x402:client": "tsx src/tools/x402Demo.ts"
  },
  "dependencies": {
    "@fastnear/x402": "2.5.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@phala/dcap-qvl": "0.7.0",
    "@rhea-finance/cross-chain-aggregation-dex": "2.1.9",
    "dotenv": "^18.0.9",
    "near-api-js": "^7.4.0"
  },
  "devDependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "@near-js/providers": "2.5.1",
    "@near-js/utils": "2.5.1",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
