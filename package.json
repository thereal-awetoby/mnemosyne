{
  "name": "mnemosyne",
  "version": "0.1.0",
  "private": true,
  "description": "Non-trading governor agent on NEAR: private decisions, on-chain memory commitments, capability-limited sub-agents, x402-paid memory queries.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cycle": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "verify:contract": "node scripts/verify-contract.mjs",
    "sub:keygen": "node scripts/gen-sub-key.mjs",
    "sub:check": "tsx src/tools/subKeyCheck.ts",
    "server": "tsx src/serve.ts",
    "x402:demo": "tsx src/tools/x402Demo.ts",
    "test": "tsx --test src/x402/*.test.ts src/private/*.test.ts",
    "x402:setup": "tsx src/tools/x402Setup.ts",
    "x402:demo:real": "tsx src/tools/x402RealDemo.ts",
    "tee:check": "tsx src/tools/teeCheck.ts"
  },
  "dependencies": {
    "@fastnear/x402": "2.5.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@phala/dcap-qvl-node": "0.3.3",
    "dotenv": "^18.0.9",
    "near-api-js": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
