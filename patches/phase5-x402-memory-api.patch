+/**
+ * Start the Mnemosyne API:  npm run server
+ *
+ * Env (all optional; see .env.example):
+ *   PORT                      default 8402
+ *   PUBLIC_URL                default http://localhost:<PORT>
+ *   GOVERNOR_ACCOUNT_ID       payTo + contract (default mnemosyne-gov.testnet)
+ *   X402_PRICE_YOCTO          price per check, default 1e21 (0.001 NEAR)
+ *   X402_FACILITATOR_URL      use a real x402 facilitator instead of the mock
+ *   X402_FACILITATOR_API_KEY  bearer token for that facilitator
+ *   X402_VERIFY_NAMED_PAYERS  "1": mock facilitator accepts named payer accounts
+ *                             (e.g. agent.testnet) after checking the key on NEAR
+ *   ADMIN_TOKEN               enables POST /memory/confess and POST /cycle/run
+ *   DATA_DIR                  default data/runtime (gitignored)
+ */
+
+import "dotenv/config";
+import { dirname, join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { createMnemosyneServer } from "./x402/server.js";
+import { HttpFacilitator, MockFacilitator, type Facilitator } from "./x402/facilitator.js";
+
+const REPO_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");
+const PORT = Number(process.env.PORT ?? 8402);
+const PUBLIC_URL = process.env.PUBLIC_URL ?? `http://localhost:${PORT}`;
+const GOVERNOR = process.env.GOVERNOR_ACCOUNT_ID ?? "mnemosyne-gov.testnet";
+const RPC_URL = process.env.NEAR_RPC_URL ?? "https://rpc.testnet.near.org";
+const DATA_DIR = resolve(process.env.DATA_DIR ?? join(REPO_ROOT, "data/runtime"));
+
+/** Named-account payer check: does `publicKey` exist on `accountId`? */
+async function keyBelongsToAccount(accountId: string, publicKey: string): Promise<boolean> {
+  try {
+    const r = await fetch(RPC_URL, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        jsonrpc: "2.0", id: "x402", method: "query",
+        params: { request_type: "view_access_key", finality: "final", account_id: accountId, public_key: publicKey },
+      }),
+    });
+    const j: any = await r.json();
+    return !j.error && !j.result?.error && j.result?.permission !== undefined;
+  } catch {
+    return false;
+  }
+}
+
+const realFacilitatorUrl = process.env.X402_FACILITATOR_URL;
+const facilitator: Facilitator = realFacilitatorUrl
+  ? new HttpFacilitator(realFacilitatorUrl, process.env.X402_FACILITATOR_API_KEY)
+  : new MockFacilitator(DATA_DIR, {
+      checkNamedAccountKey: process.env.X402_VERIFY_NAMED_PAYERS === "1" ? keyBelongsToAccount : undefined,
+    });
+
+const { server, memory } = createMnemosyneServer({
+  dataDir: DATA_DIR,
+  seedPath: join(REPO_ROOT, "data/seed-memory.json"),
+  publicUrl: PUBLIC_URL,
+  payTo: GOVERNOR,
+  network: "near:testnet",
+  asset: "NEAR",
+  priceAmount: process.env.X402_PRICE_YOCTO ?? "1000000000000000000000",
+  maxTimeoutSeconds: 300,
+  facilitator,
+  mockSettlement: !realFacilitatorUrl,
+  adminToken: process.env.ADMIN_TOKEN || undefined,
+  readChainHead: async () => {
+    const { getLatestMemoryRecord } = await import("./memory.js");
+    const rec = await getLatestMemoryRecord();
+    return rec ? { latest_hash: rec.decision_hash, prev_hash: rec.prev_memory_hash } : null;
+  },
+  runCycle: async () => {
+    const { runCycle } = await import("./cycle.js");
+    const r = await runCycle();
+    // Public parts only. privateDecision (the reasoning) never leaves.
+    return {
+      committed: r.committed,
+      cycle_id: r.memoryRecord.cycle_id,
+      decision_hash: r.memoryRecord.decision_hash,
+      prev_memory_hash: r.memoryRecord.prev_memory_hash,
+      decisions: r.memoryRecord.decisions,
+      reports: r.reports ?? [],
+    };
+  },
+});
+
+server.listen(PORT, () => {
+  console.log(`Mnemosyne API on ${PUBLIC_URL}`);
+  console.log(`  memory entries: ${memory.size}   payTo: ${GOVERNOR}   data: ${DATA_DIR}`);
+  console.log(`  facilitator: ${realFacilitatorUrl ? realFacilitatorUrl : "MOCK (verifies everything, settles to a local ledger)"}`);
+  console.log(`  admin routes: ${process.env.ADMIN_TOKEN ? "enabled" : "disabled (set ADMIN_TOKEN)"}`);
+});
diff --git a/src/tools/x402Demo.ts b/src/tools/x402Demo.ts
new file mode 100644
index 0000000..14c78e5
--- /dev/null
+++ b/src/tools/x402Demo.ts
@@ -0,0 +1,94 @@
+/**
+ * Plays an EXTERNAL agent paying Mnemosyne for a memory check via x402.
+ *
+ *   npm run server          (terminal 1)
+ *   npm run x402:demo       (terminal 2)
+ *   npm run x402:demo -- "your own situation text"
+ *
+ * The agent has no account with Mnemosyne and no API key. It pays from a NEAR
+ * implicit account (id = hex of its public key). Set EXTERNAL_AGENT_SECRET_KEY
+ * in .env to reuse one identity; otherwise a fresh one is made each run.
+ */
+
+import "dotenv/config";
+import { b64json, canonicalJson, fromB64json, generateNearKeyPair, implicitAccountId, publicKeyOfSecret, sha256Hex } from "../x402/crypto.js";
+import { postWithPayment, type Payer } from "../x402/client.js";
+import type { PaymentRequired } from "../x402/types.js";
+
+const BASE = (process.env.MNEMOSYNE_URL ?? "http://localhost:8402").replace(/\/$/, "");
+const QUERY =
+  process.argv.slice(2).join(" ") ||
+  "I am about to delete the old full access key on my agent account before the replacement key is tested";
+const MAX_PRICE = 10n ** 22n; // agent's own spending limit: 0.01 NEAR per call
+
+function payer(): Payer {
+  const sk = process.env.EXTERNAL_AGENT_SECRET_KEY || generateNearKeyPair().secretKey;
+  return { secretKey: sk, accountId: implicitAccountId(publicKeyOfSecret(sk)) };
+}
+
+const line = (s = "") => console.log(s);
+const near = (yocto: string) => `${(Number(BigInt(yocto) / 10n ** 18n) / 1e6).toFixed(6)} NEAR`;
+
+async function main() {
+  const agent = payer();
+  line(`\nExternal agent ${agent.accountId.slice(0, 12)}... (NEAR implicit account) -> ${BASE}`);
+  line(`Situation: "${QUERY}"\n`);
+
+  // 1. Ask without paying.
+  line("[1] POST /memory/check with no payment");
+  const r1 = await fetch(`${BASE}/memory/check`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ query: QUERY }),
+  });
+  const quote = fromB64json<PaymentRequired>(r1.headers.get("payment-required") ?? b64json(await r1.json()));
+  const req = quote.accepts[0];
+  line(`    -> HTTP ${r1.status} Payment Required`);
+  line(`       price ${near(req.amount)} to ${req.payTo} on ${req.network} (${req.extra.mock ? "MOCK settlement" : "real settlement"})`);
+
+  // 2. Pay and retry.
+  line("\n[2] Sign the quoted price with the agent's key, retry with PAYMENT-SIGNATURE");
+  const paid = await postWithPayment<any>(`${BASE}/memory/check`, { query: QUERY }, agent, {
+    maxAmount: MAX_PRICE,
+  });
+  if (paid.status !== 200) {
+    line(`    -> HTTP ${paid.status}: ${JSON.stringify(paid.body)}`);
+    process.exitCode = 1;
+    return;
+  }
+  const { receipt_id, ...answer } = paid.body;
+  line(`    -> HTTP 200`);
+  line(`       match:      ${answer.match}${answer.match ? `  (citation ${answer.citation_id}, ${answer.category}, score ${answer.score})` : ""}`);
+  if (answer.advice) line(`       advice:     ${answer.advice}`);
+  line(`       settlement: ${paid.settlement?.transaction}${paid.settlement && (paid.settlement as any).mock ? " (mock)" : ""}`);
+  line(`       receipt:    ${receipt_id}`);
+
+  // 3. Check the receipt matches what we were told.
+  line(`\n[3] GET /memory/receipt/${receipt_id}`);
+  const receipt: any = await (await fetch(`${BASE}/memory/receipt/${receipt_id}`)).json();
+  const answerOk = receipt.answer_sha256 === sha256Hex(canonicalJson(answer));
+  const queryOk = receipt.request_sha256 === sha256Hex(canonicalJson({ query: QUERY }));
+  line(`    -> paid ${near(receipt.amount)} by ${String(receipt.payer).slice(0, 12)}..., citation ${receipt.citation_id}`);
+  line(`       answer hash matches what we received: ${answerOk ? "YES" : "NO"}`);
+  line(`       query hash matches what we sent:      ${queryOk ? "YES" : "NO"}  (the query text itself is not stored)`);
+
+  // 4. Try to reuse the same payment.
+  line("\n[4] Replay the exact same PAYMENT-SIGNATURE");
+  const replay = await fetch(`${BASE}/memory/check`, {
+    method: "POST",
+    headers: { "content-type": "application/json", "PAYMENT-SIGNATURE": paid.paymentHeader },
+    body: JSON.stringify({ query: QUERY }),
+  });
+  const replayBody: any = await replay.json();
+  line(`    -> HTTP ${replay.status}: ${replayBody.error}`);
+
+  const ok = answerOk && queryOk && replay.status === 402;
+  line(`\n${ok ? "DEMO OK" : "DEMO FAILED"} -- 402 -> pay -> answer -> receipt verified -> replay rejected\n`);
+  process.exitCode = ok ? 0 : 1;
+}
+
+main().catch((err) => {
+  console.error(`\ndemo failed: ${(err as Error).message}`);
+  console.error(`Is the server running? Start it with: npm run server\n`);
+  process.exitCode = 1;
+});
diff --git a/src/x402/client.ts b/src/x402/client.ts
new file mode 100644
index 0000000..bb67f5b
--- /dev/null
+++ b/src/x402/client.ts
@@ -0,0 +1,87 @@
+/**
+ * Minimal x402 client for agents paying Mnemosyne (or any server using the
+ * same mock NEAR scheme). No account signup, no API key: request, get 402,
+ * sign the quoted price, retry.
+ */
+
+import { randomBytes } from "node:crypto";
+import { b64json, fromB64json, publicKeyOfSecret, signMessage } from "./crypto.js";
+import { authorizationMessage } from "./facilitator.js";
+import {
+  X402_VERSION,
+  type MockAuthorization,
+  type PaymentPayload,
+  type PaymentRequired,
+  type PaymentRequirements,
+  type SettlementResponse,
+} from "./types.js";
+
+export interface Payer {
+  accountId: string;
+  secretKey: string;
+}
+
+export function buildPayment(req: PaymentRequirements, resourceUrl: string, payer: Payer, nowMs = Date.now()): PaymentPayload {
+  const now = Math.floor(nowMs / 1000);
+  const authorization: MockAuthorization = {
+    from: payer.accountId,
+    to: req.payTo,
+    value: req.amount,
+    asset: req.asset,
+    network: req.network,
+    resource: resourceUrl,
+    validAfter: now - 1,
+    validBefore: now + Math.min(req.maxTimeoutSeconds, 120),
+    nonce: randomBytes(16).toString("hex"),
+  };
+  return {
+    x402Version: X402_VERSION,
+    accepted: req,
+    payload: {
+      authorization,
+      publicKey: publicKeyOfSecret(payer.secretKey),
+      signature: signMessage(payer.secretKey, authorizationMessage(authorization)),
+    },
+  };
+}
+
+export interface PaidCallResult<T> {
+  quote: PaymentRequired;
+  status: number;
+  body: T;
+  settlement: SettlementResponse | null;
+  paymentHeader: string;
+}
+
+/** POST JSON to an x402 endpoint, paying if asked. Refuses to pay more than
+ *  `maxAmount` (base units) or to anyone not in `allowedPayTo`. */
+export async function postWithPayment<T = any>(
+  url: string,
+  body: unknown,
+  payer: Payer,
+  limits: { maxAmount: bigint; allowedPayTo?: string[] }
+): Promise<PaidCallResult<T>> {
+  const first = await fetch(url, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
+  if (first.status !== 402) throw new Error(`expected 402 from ${url}, got ${first.status}: ${await first.text()}`);
+  const header = first.headers.get("payment-required");
+  const quote: PaymentRequired = header ? fromB64json(header) : await first.json();
+  const req = quote.accepts.find((r) => r.scheme === "exact");
+  if (!req) throw new Error("server offers no 'exact' payment option");
+  if (BigInt(req.amount) > limits.maxAmount) throw new Error(`price ${req.amount} exceeds limit ${limits.maxAmount}`);
+  if (limits.allowedPayTo && !limits.allowedPayTo.includes(req.payTo)) throw new Error(`refusing to pay unknown recipient ${req.payTo}`);
+
+  const paymentHeader = b64json(buildPayment(req, quote.resource.url, payer));
+  const paid = await fetch(url, {
+    method: "POST",
+    headers: { "content-type": "application/json", "PAYMENT-SIGNATURE": paymentHeader },
+    body: JSON.stringify(body),
+  });
+  const settleHeader = paid.headers.get("payment-response");
+  return {
+    quote,
+    status: paid.status,
+    body: (await paid.json()) as T,
+    settlement: settleHeader ? fromB64json<SettlementResponse>(settleHeader) : null,
+    paymentHeader,
+  };
+}
diff --git a/src/x402/crypto.ts b/src/x402/crypto.ts
new file mode 100644
index 0000000..dbd4cb4
--- /dev/null
+++ b/src/x402/crypto.ts
@@ -0,0 +1,101 @@
+/**
+ * Ed25519 helpers using NEAR key formats, on node:crypto only (no deps).
+ *
+ *   public key  "ed25519:" + base58(32 bytes)
+ *   secret key  "ed25519:" + base58(seed32 || pub32)   (near-api-js layout)
+ *
+ * NEAR implicit accounts: the account id IS hex(public key), 64 lowercase hex
+ * chars. That lets the facilitator prove "this key belongs to the payer
+ * account" offline, with no RPC, for implicit-account payers.
+ */
+
+import { createHash, createPrivateKey, createPublicKey, generateKeyPairSync, sign, verify } from "node:crypto";
+import { base58Decode, base58Encode } from "../nearTx.js";
+
+const PKCS8_ED25519_PREFIX = Buffer.from("302e020100300506032b657004220420", "hex");
+
+function decodeKey(s: string, expectedLen: number, what: string): Buffer {
+  if (!s.startsWith("ed25519:")) throw new Error(`${what} must start with "ed25519:"`);
+  const raw = base58Decode(s.slice("ed25519:".length));
+  if (raw.length !== expectedLen) throw new Error(`${what} decodes to ${raw.length} bytes, expected ${expectedLen}`);
+  return raw;
+}
+
+export function publicKeyBytes(publicKey: string): Buffer {
+  return decodeKey(publicKey, 32, "public key");
+}
+
+export function publicKeyOfSecret(secretKey: string): string {
+  return "ed25519:" + base58Encode(decodeKey(secretKey, 64, "secret key").subarray(32));
+}
+
+export function implicitAccountId(publicKey: string): string {
+  return publicKeyBytes(publicKey).toString("hex");
+}
+
+export function isImplicitAccountId(id: string): boolean {
+  return /^[0-9a-f]{64}$/.test(id);
+}
+
+export function signMessage(secretKey: string, message: Buffer): string {
+  const raw = decodeKey(secretKey, 64, "secret key");
+  const key = createPrivateKey({
+    key: Buffer.concat([PKCS8_ED25519_PREFIX, raw.subarray(0, 32)]),
+    format: "der",
+    type: "pkcs8",
+  });
+  return "ed25519:" + base58Encode(sign(null, message, key));
+}
+
+export function verifyMessage(publicKey: string, message: Buffer, signature: string): boolean {
+  try {
+    const sig = decodeKey(signature, 64, "signature");
+    const key = createPublicKey({
+      key: { kty: "OKP", crv: "Ed25519", x: publicKeyBytes(publicKey).toString("base64url") },
+      format: "jwk",
+    });
+    return verify(null, message, key, sig);
+  } catch {
+    return false;
+  }
+}
+
+/** Deterministic JSON: object keys sorted recursively. Both sides must hash
+ *  and sign exactly the same bytes, whatever order fields were written in. */
+export function canonicalJson(value: unknown): string {
+  if (value === null || typeof value !== "object") return JSON.stringify(value);
+  if (Array.isArray(value)) return "[" + value.map(canonicalJson).join(",") + "]";
+  const obj = value as Record<string, unknown>;
+  return (
+    "{" +
+    Object.keys(obj)
+      .filter((k) => obj[k] !== undefined)
+      .sort()
+      .map((k) => JSON.stringify(k) + ":" + canonicalJson(obj[k]))
+      .join(",") +
+    "}"
+  );
+}
+
+export function sha256Hex(data: string | Buffer): string {
+  return createHash("sha256").update(data).digest("hex");
+}
+
+export function b64json(value: unknown): string {
+  return Buffer.from(JSON.stringify(value), "utf8").toString("base64");
+}
+
+export function fromB64json<T = unknown>(s: string): T {
+  return JSON.parse(Buffer.from(s, "base64").toString("utf8")) as T;
+}
+
+/** Fresh NEAR-format ed25519 keypair (same layout near-api-js uses). */
+export function generateNearKeyPair(): { publicKey: string; secretKey: string } {
+  const { publicKey, privateKey } = generateKeyPairSync("ed25519");
+  const pub = Buffer.from(publicKey.export({ format: "jwk" }).x as string, "base64url");
+  const seed = Buffer.from(privateKey.export({ format: "jwk" }).d as string, "base64url");
+  return {
+    publicKey: "ed25519:" + base58Encode(pub),
+    secretKey: "ed25519:" + base58Encode(Buffer.concat([seed, pub])),
+  };
+}
diff --git a/src/x402/facilitator.ts b/src/x402/facilitator.ts
new file mode 100644
index 0000000..f0a5192
--- /dev/null
+++ b/src/x402/facilitator.ts
@@ -0,0 +1,206 @@
+/**
+ * x402 facilitators: the service that checks a payment and settles it.
+ *
+ * MockFacilitator (default) does every check a real one would -- signature,
+ * payer identity, amount, recipient, network, resource binding, time window,
+ * single-use nonce -- but "settles" by writing to a local ledger instead of
+ * moving tokens. Every settlement id starts with "mock_" and every response
+ * says mock:true, so nothing can pass it off as an on-chain transfer.
+ *
+ * HttpFacilitator talks to a real x402 facilitator's POST /verify and
+ * POST /settle (same request/response shapes), for when one exists for NEAR.
+ */
+
+import { join } from "node:path";
+import { JsonStore } from "./jsonStore.js";
+import {
+  canonicalJson,
+  implicitAccountId,
+  isImplicitAccountId,
+  sha256Hex,
+  verifyMessage,
+} from "./crypto.js";
+import {
+  SIGNING_DOMAIN,
+  X402_VERSION,
+  type PaymentPayload,
+  type PaymentRequirements,
+  type SettlementResponse,
+  type VerifyResponse,
+} from "./types.js";
+
+export interface Facilitator {
+  verify(payload: PaymentPayload, requirements: PaymentRequirements): Promise<VerifyResponse>;
+  settle(payload: PaymentPayload, requirements: PaymentRequirements): Promise<SettlementResponse>;
+}
+
+/** Bytes the payer signs: domain tag + canonical JSON of the authorization. */
+export function authorizationMessage(auth: PaymentPayload["payload"]["authorization"]): Buffer {
+  return Buffer.from(SIGNING_DOMAIN + canonicalJson(auth), "utf8");
+}
+
+/** Optional hook: prove a NAMED payer account (e.g. agent.testnet) owns the
+ *  public key, e.g. via NEAR view_access_key. Implicit accounts don't need it. */
+export type KeyOwnershipCheck = (accountId: string, publicKey: string) => Promise<boolean>;
+
+interface Ledger {
+  /** nonce -> settlement id. Spent nonces are never accepted again. */
+  spentNonces: Record<string, string>;
+  settlements: Array<{
+    id: string;
+    payer: string;
+    payTo: string;
+    amount: string;
+    asset: string;
+    network: string;
+    resource: string;
+    nonce: string;
+    at: string;
+  }>;
+}
+
+const CLOCK_SKEW_SECONDS = 5;
+
+export class MockFacilitator implements Facilitator {
+  private ledger: JsonStore<Ledger>;
+
+  constructor(
+    dataDir: string,
+    private readonly opts: { checkNamedAccountKey?: KeyOwnershipCheck; now?: () => number } = {}
+  ) {
+    this.ledger = new JsonStore<Ledger>(join(dataDir, "facilitator-ledger.json"), () => ({
+      spentNonces: {},
+      settlements: [],
+    }));
+  }
+
+  private nowSeconds(): number {
+    return Math.floor((this.opts.now ? this.opts.now() : Date.now()) / 1000);
+  }
+
+  async verify(p: PaymentPayload, req: PaymentRequirements): Promise<VerifyResponse> {
+    const bad = (invalidReason: string, payer: string | null = null): VerifyResponse => ({
+      isValid: false,
+      payer,
+      invalidReason,
+    });
+
+    if (!p || typeof p !== "object") return bad("invalid_payload");
+    if (p.x402Version !== X402_VERSION) return bad("invalid_x402_version");
+    const a = p.payload?.authorization;
+    const publicKey = p.payload?.publicKey;
+    const signature = p.payload?.signature;
+    if (!a || typeof publicKey !== "string" || typeof signature !== "string") return bad("invalid_payload");
+    const payer = typeof a.from === "string" ? a.from : null;
+
+    // The payer must have accepted exactly what we asked for.
+    if (canonicalJson(p.accepted) !== canonicalJson(req)) return bad("requirements_mismatch", payer);
+
+    if (a.to !== req.payTo) return bad("invalid_recipient", payer);
+    if (a.asset !== req.asset) return bad("invalid_asset", payer);
+    if (a.network !== req.network) return bad("invalid_network", payer);
+    if (typeof a.resource !== "string" || a.resource.length === 0) return bad("invalid_resource", payer);
+    let value: bigint;
+    try {
+      value = BigInt(a.value);
+    } catch {
+      return bad("invalid_amount", payer);
+    }
+    if (value < BigInt(req.amount)) return bad("insufficient_amount", payer);
+
+    const now = this.nowSeconds();
+    if (!Number.isInteger(a.validAfter) || !Number.isInteger(a.validBefore)) return bad("invalid_time_window", payer);
+    if (a.validAfter > now + CLOCK_SKEW_SECONDS) return bad("not_yet_valid", payer);
+    if (a.validBefore <= now) return bad("expired", payer);
+    if (a.validBefore - a.validAfter > req.maxTimeoutSeconds + CLOCK_SKEW_SECONDS) {
+      return bad("time_window_too_long", payer);
+    }
+
+    if (typeof a.nonce !== "string" || !/^[0-9a-f]{32,128}$/.test(a.nonce)) return bad("invalid_nonce", payer);
+    if (this.ledger.get().spentNonces[a.nonce]) return bad("nonce_already_used", payer);
+
+    if (!verifyMessage(publicKey, authorizationMessage(a), signature)) return bad("invalid_signature", payer);
+
+    // Identity: the signing key must belong to the `from` account.
+    if (!payer) return bad("invalid_payer", payer);
+    if (isImplicitAccountId(payer)) {
+      if (implicitAccountId(publicKey) !== payer) return bad("payer_key_mismatch", payer);
+    } else if (this.opts.checkNamedAccountKey) {
+      if (!(await this.opts.checkNamedAccountKey(payer, publicKey))) return bad("payer_key_mismatch", payer);
+    } else {
+      return bad("named_payer_unverifiable", payer);
+    }
+
+    return { isValid: true, payer, invalidReason: null };
+  }
+
+  async settle(p: PaymentPayload, req: PaymentRequirements): Promise<SettlementResponse> {
+    const v = await this.verify(p, req);
+    if (!v.isValid) {
+      return {
+        success: false,
+        transaction: null,
+        network: req.network,
+        payer: v.payer,
+        amount: null,
+        errorReason: v.invalidReason ?? "invalid",
+      };
+    }
+    const a = p.payload.authorization;
+    const id = "mock_" + sha256Hex(canonicalJson(p)).slice(0, 40);
+    // Re-check and record in one synchronous step: no await between them, so
+    // two concurrent settles of the same nonce can't both succeed.
+    if (this.ledger.get().spentNonces[a.nonce]) {
+      return { success: false, transaction: null, network: req.network, payer: v.payer, amount: null, errorReason: "nonce_already_used" };
+    }
+    this.ledger.update((l) => {
+      l.spentNonces[a.nonce] = id;
+      l.settlements.push({
+        id,
+        payer: a.from,
+        payTo: a.to,
+        amount: a.value,
+        asset: a.asset,
+        network: a.network,
+        resource: a.resource,
+        nonce: a.nonce,
+        at: new Date().toISOString(),
+      });
+    });
+    return { success: true, transaction: id, network: req.network, payer: a.from, amount: a.value };
+  }
+}
+
+/** Client for a real x402 facilitator (POST {base}/verify, {base}/settle). */
+export class HttpFacilitator implements Facilitator {
+  constructor(private readonly baseUrl: string, private readonly apiKey?: string) {}
+
+  private async post<T>(path: string, p: PaymentPayload, req: PaymentRequirements): Promise<T> {
+    const res = await fetch(this.baseUrl.replace(/\/$/, "") + path, {
+      method: "POST",
+      headers: {
+        "content-type": "application/json",
+        ...(this.apiKey ? { authorization: `Bearer ${this.apiKey}` } : {}),
+      },
+      body: JSON.stringify({ x402Version: X402_VERSION, paymentPayload: p, paymentRequirements: req }),
+    });
+    if (!res.ok) throw new Error(`facilitator ${path} HTTP ${res.status}`);
+    return (await res.json()) as T;
+  }
+
+  async verify(p: PaymentPayload, req: PaymentRequirements): Promise<VerifyResponse> {
+    try {
+      return await this.post<VerifyResponse>("/verify", p, req);
+    } catch (err) {
+      return { isValid: false, payer: null, invalidReason: `facilitator_unreachable: ${(err as Error).message}` };
+    }
+  }
+
+  async settle(p: PaymentPayload, req: PaymentRequirements): Promise<SettlementResponse> {
+    try {
+      return await this.post<SettlementResponse>("/settle", p, req);
+    } catch (err) {
+      return { success: false, transaction: null, network: req.network, payer: null, amount: null, errorReason: `facilitator_unreachable: ${(err as Error).message}` };
+    }
+  }
+}
diff --git a/src/x402/jsonStore.ts b/src/x402/jsonStore.ts
new file mode 100644
index 0000000..1979779
--- /dev/null
+++ b/src/x402/jsonStore.ts
@@ -0,0 +1,33 @@
+/**
+ * Tiny JSON-file persistence with atomic writes (write temp file, rename).
+ * Good enough for one server process; not a database.
+ */
+
+import { existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from "node:fs";
+import { dirname } from "node:path";
+
+export class JsonStore<T> {
+  private value: T;
+
+  constructor(private readonly path: string, initial: () => T) {
+    if (existsSync(path)) {
+      this.value = JSON.parse(readFileSync(path, "utf8")) as T;
+    } else {
+      this.value = initial();
+    }
+  }
+
+  get(): T {
+    return this.value;
+  }
+
+  /** Mutate, then persist. If the write fails the error propagates, so a
+   *  caller never reports success for state that wasn't saved. */
+  update(fn: (v: T) => void): void {
+    fn(this.value);
+    mkdirSync(dirname(this.path), { recursive: true });
+    const tmp = `${this.path}.${process.pid}.tmp`;
+    writeFileSync(tmp, JSON.stringify(this.value, null, 2));
+    renameSync(tmp, this.path);
+  }
+}
